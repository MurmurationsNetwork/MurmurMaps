{
	"name": "murmur-maps",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"db:generate": "pnpm exec drizzle-kit generate",
		"db:migrate": "pnpm exec wrangler d1 migrations apply murmur-maps-preview --local",
		"db:migrate:preview": "pnpm exec wrangler d1 migrations apply murmur-maps-preview --remote",
		"db:migrate:prod": "pnpm exec wrangler d1 migrations apply murmur-maps --remote --env production",
		"generate-server-keys": "pnpm exec tsx scripts/generate-server-keys.ts"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260804.1",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.30.0",
		"@paralleldrive/cuid2": "^3.3.0",
		"@playwright/test": "^1.62.1",
		"@react-email/render": "^2.1.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/container-queries": "^0.1.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/table-core": "^8.21.3",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/json-schema": "^7.0.15",
		"@types/leaflet": "^1.9.22",
		"@types/leaflet.markercluster": "^1.5.6",
		"@types/node": "^24.13.3",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.9.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"mode-watcher": "^1.1.0",
		"pako": "^3.0.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.10",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0",
		"vite": "^8.2.0",
		"vite-plugin-devtools-json": "^1.1.0",
		"vitest": "^4.1.10",
		"wrangler": "^4.120.0"
	},
	"dependencies": {
		"@tanstack/svelte-query": "^6.1.38",
		"@ucans/ucans": "^0.12.0",
		"diff": "^9.0.0",
		"drizzle-orm": "^0.45.2",
		"leaflet": "^1.9.4",
		"leaflet.markercluster": "^1.5.3",
		"paneforge": "1.0.2",
		"resend": "^6.18.1",
		"uint8arrays": "^6.1.1",
		"vaul-svelte": "1.0.0-next.7"
	},
	"lint-staged": {
		"*.{ts,svelte}": [
			"pnpm format",
			"pnpm lint"
		],
		"*.{css,html,json}": [
			"pnpm format"
		]
	}
}
